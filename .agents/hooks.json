{
  "block-env-access": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|view_file_outline|view_code_item|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|grep_search|find_by_name|list_dir|run_workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/block-env-access.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
